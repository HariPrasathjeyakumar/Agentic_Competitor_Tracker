# GEMINI_API_KEY: Required for live Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fallback LLM provider key.
GROQ_API_KEY=""

# LOCAL_MODE: Explicit server flag enabling local-only Live runs and Mock Site toggle.
# Keep 0 in shared/public deployments; set to 1 only on your local machine.
LOCAL_MODE="0"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
